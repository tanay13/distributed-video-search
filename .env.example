# DEVELOPMENT ONLY. Copy this file to .env and choose your own passwords. Never commit .env.

# --- shared: database + object storage (vsearch/common/config.py)
POSTGRES_USER=video_app
POSTGRES_PASSWORD=replace_with_local_dev_password
POSTGRES_DB=video_search
POSTGRES_PORT=5433

MINIO_ROOT_USER=video_minio_admin
MINIO_ROOT_PASSWORD=replace_with_long_minio_password
MINIO_BUCKET=videos
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- pipeline (Tanay): vsearch/pipeline/settings.py
SEGMENT_SEC=30
SEGMENT_OVERLAP_SEC=2

# --- indexing (Aditya): vsearch/indexing/settings.py
FIXED_FPS=1
KEEP_FRAMES=0

# --- search (Darshil): vsearch/search/settings.py
CANDIDATE_FRAMES=50
SCORE_MARGIN=0.05
MERGE_GAP_SEC=2.0
ANTHROPIC_API_KEY=
