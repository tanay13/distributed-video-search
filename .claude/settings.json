{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/check_ownership.py\"",
            "timeout": 10,
            "statusMessage": "Checking file ownership (OWNERS)"
          }
        ]
      }
    ]
  }
}
